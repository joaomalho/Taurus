# Secrets: never bake them into the image (docker compose passes them via env_file)
.env
.env.*
!.env.example

# VCS and CI
.git
.github

# Python caches and virtualenvs
**/__pycache__
**/*.pyc
**/*.pyo
env/
venv/
.venv/

# Generated at runtime/deploy
market-analyzer/frontend_app/staticfiles/
celerybeat-schedule
celerybeat.pid
**/celerybeat-schedule
*.log

# Editor/OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Not needed inside the container
docs/
assets/
**/*.ipynb
