# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Gunicorn (production)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# HTTP port exposed by Nginx in production
HTTP_PORT=80

# Rate limiting (requests per IP per window in seconds)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_API=120
RATE_LIMIT_HEAVY=20
RATE_LIMIT_WINDOW=60

# Screener cache + Celery Beat
SCREENER_CACHE_TTL=900
SCREENER_REFRESH_INTERVAL=900

# PostgreSQL (used by Django settings.py)
DB_NAME=taurus_db
DB_USER=taurus_user
DB_PASSWORD=taurus_pass
DB_HOST=db
DB_PORT=5432

# PostgreSQL (used by docker-compose db service)
POSTGRES_USER=taurus_user
POSTGRES_PASSWORD=taurus_pass
POSTGRES_DB=taurus_db

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CACHE_KEY_PREFIX=webapp

# Optional — economic calendar (TradingEconomics). Without this, Forex Factory free feed is used.
# TRADING_ECONOMICS_KEY=your_key:your_secret
